# Public URL of your backend API (no trailing slash)
# TravelHub auth expects the Railway session host below.
REACT_APP_API_BASE=https://slumber-production.up.railway.app

# Optional timeout tuning (milliseconds)
REACT_APP_REQUEST_TIMEOUT_MS=5000
REACT_APP_AI_REQUEST_TIMEOUT_MS=45000

# Affiliate IDs (add after approvals)
REACT_APP_BOOKING_AID=
REACT_APP_KIWI_ID=
REACT_APP_GYG_PARTNER_ID=
REACT_APP_TRIPADVISOR_ID=

# MapTiler vector basemap (replaces the raw OSM raster tiles — required in
# production, OSM's tile server forbids commercial/production load).
# Free key: https://cloud.maptiler.com/account/keys/
# Without a key the map falls back to MapLibre's open demo style.
REACT_APP_MAPTILER_KEY=
# Optional: override the built-in style id (default: backdrop-dark)
REACT_APP_MAPTILER_STYLE=

